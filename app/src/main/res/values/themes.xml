<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- windowBackground avoids a white flash before Compose draws the Broadsheet background. -->
    <style name="Theme.Leo" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/leo_window_background</item>
    </style>

    <!--
        The system splash screen (core-splashscreen, all API levels): the ground, and the "Leo" wordmark as its icon
        (drawable/splash_icon.xml, glyph outlines placed where the launch intro's first frame draws the text), so
        the hand-off to the intro has no visible cut (see phase-4 changes.md, Q5 and review round 1, B4).
    -->
    <style name="Theme.Leo.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/leo_window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Leo</item>
    </style>
</resources>

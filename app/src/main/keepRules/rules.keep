# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}

# ML Kit's structured output parses the model's JSON into these classes by reflection and builds their schema
# from the generated GenerableProvider classes. Without the rules R8 renames the members and parsing fails.
-keep class com.victorarana.leo.data.genai.GeneratedExercise { *; }
-keep class com.victorarana.leo.data.genai.TopicReview { *; }
-keep class * implements com.google.mlkit.genai.schema.guided.GenerableProvider { *; }
